# ---------------- Transcription (Whisper) ----------------
# groq  = free Groq API, ~1 minute per hour of video (get a key: https://console.groq.com/keys)
# local = runs on your CPU with faster-whisper: unlimited and offline, but slow on a laptop
TRANSCRIBE=groq
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# local model size: tiny / base / small / medium  (bigger = more accurate, slower)
LOCAL_WHISPER_MODEL=small

# ---------------- LLM (picks clips + writes captions) ----------------
# Any OpenAI-compatible endpoint works. Pick ONE block.

# OpenRouter free models (key: https://openrouter.ai/keys) - 50 requests/day free
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Comma-separated: if the first is rate-limited, the next is tried.
# Run `python clipper.py --list-models` to see current free models.
LLM_MODEL=

# Groq (same key as above works) - fast, but free tier has small tokens-per-minute limits
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=<your groq key>
# LLM_MODEL=

# Ollama on your own machine - truly unlimited, needs a strong PC
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=qwen3:8b
